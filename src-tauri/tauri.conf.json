{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Лестница Lua",
  "version": "0.1.0",
  "identifier": "local.learninglua.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "Локальный учебный кабинет по Lua",
    "longDescription": "Наставник по Lua: теория, практика, проверка уроков и итоги занятий.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
