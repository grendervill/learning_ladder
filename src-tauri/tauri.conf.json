{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Лестница обучения",
  "version": "0.1.1",
  "identifier": "local.learning-ladder.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && node scripts/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Локальный учебный кабинет «Лестница обучения»",
    "longDescription": "Курсы, наставники, практика и итоги занятий. Локальный учебный кабинет без облака.",
    "resources": {
      "resources/server": "server",
      "resources/web": "web",
      "resources/node": "node"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
